{
  "name": "freescribe",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only Chrome MV3 extension for saving visible Google Meet captions as a raw text transcript.",
  "license": "Apache-2.0",
  "author": "Wasif Ali",
  "homepage": "https://github.com/iWasifAli/FreeScribe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iWasifAli/FreeScribe.git"
  },
  "bugs": {
    "url": "https://github.com/iWasifAli/FreeScribe/issues"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "google-meet",
    "captions",
    "transcript",
    "local-first"
  ],
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.background.json && tsc -p tsconfig.content.json && tsc -p tsconfig.sidepanel.json && node scripts/copy-assets.mjs",
    "build:test": "tsc -p tsconfig.shared.json",
    "package": "npm run build && node scripts/package-extension.mjs",
    "test": "npm run build:test && node --test tests/*.test.mjs"
  },
  "packageManager": "npm@11.12.1",
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
